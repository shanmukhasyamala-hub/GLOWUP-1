# GLOWUP — Environment Variables Reference
# Never commit real .env files or private keys to GitHub.
#
# Firebase Authentication & Cloud Firestore:
# Public client configuration is stored in /firebase-applet-config.json
# (safe client identifiers; protected by Firestore Security Rules and
# Firebase Console Authorized Domains).
#
# Optional / Future Server-Side Variables (not required for current client build):
# GEMINI_API_KEY="YOUR_SERVER_SIDE_GEMINI_API_KEY"
# APP_URL="https://your-production-domain.vercel.app"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
